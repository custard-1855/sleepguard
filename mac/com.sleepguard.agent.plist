<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sleepguard.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/SleepGuard/sleepguard.sh</string>
  </array>
  <!-- 毎分起動する。22時〜6時の外ではスクリプトがすぐ終わる。
       StartCalendarInterval で Minute を省いても毎分にはならず、毎時0分に1回しか起動しない -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/sleepguard.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/sleepguard.log</string>
</dict>
</plist>
